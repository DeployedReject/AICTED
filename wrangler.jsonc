{
  "name": "aicted",
  "main": "workers/web/index.ts",
  "compatibility_date": "2026-10-18",
  "assets": {
    "binding": "ASSETS",
    "directory": "./dist",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"],
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "aicted-workspace",
      "database_id": "89aee8a9-9366-4a4c-a7ec-031ed3edb9a8",
      "migrations_dir": "database/migrations",
    },
  ],
  "services": [{ "binding": "CASEWORK", "service": "aicted-casework" }],
  "ratelimits": [
    {
      "name": "AUTH_LIMITER",
      "namespace_id": "1001",
      "simple": { "limit": 12, "period": 60 },
    },
    {
      "name": "WRITE_LIMITER",
      "namespace_id": "1002",
      "simple": { "limit": 45, "period": 60 },
    },
  ],
}
