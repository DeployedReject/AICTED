{
  "name": "aicted",
  "main": "workers/web/index.ts",
  "compatibility_date": "2026-10-18",
  "assets": {
    "binding": "ASSETS",
    "directory": "./dist",
    "not_found_handling": "single-page-application",
    "run_worker_first": [
      "/api/*",
      "/workspace",
      "/workspace/*",
      "/it/workspace",
      "/it/setup",
      "/it/workspace/*",
    ],
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "aicted-workspace",
      "database_id": "89aee8a9-9366-4a4c-a7ec-031ed3edb9a8",
      "migrations_dir": "database/migrations",
    },
  ],
  "services": [
    { "binding": "DOCUMENTS", "service": "aicted-documents" },
    { "binding": "DATABASE", "service": "aicted-database" },
    { "binding": "CASEWORK", "service": "aicted-casework" },
    { "binding": "NOTIFICATIONS", "service": "aicted-notifications" },
  ],
  "ratelimits": [
    {
      "name": "AUTH_LIMITER",
      "namespace_id": "1001",
      "simple": { "limit": 12, "period": 60 },
    },
    {
      "name": "WRITE_LIMITER",
      "namespace_id": "1002",
      "simple": { "limit": 45, "period": 60 },
    },
  ],
}
