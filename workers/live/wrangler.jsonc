{
  "name": "aicted-live",
  "main": "index.ts",
  "compatibility_date": "2026-10-18",
  "workers_dev": false,
  "preview_urls": false,
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "aicted-workspace",
      "database_id": "89aee8a9-9366-4a4c-a7ec-031ed3edb9a8",
      "migrations_dir": "../../database/migrations",
    },
  ],
  "services": [{ "binding": "DATABASE", "service": "aicted-database" }],
  "durable_objects": {
    "bindings": [{ "name": "ROOM", "class_name": "LiveRoom" }],
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["LiveRoom"] }],
  "triggers": { "crons": [] },
}
